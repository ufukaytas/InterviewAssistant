# Copy this file to .env and fill in real values for local development.
# NEVER commit a real .env file. Secrets must never be pushed to GitHub.

# --- General ---------------------------------------------------------------
APP_ENV=development
APP_NAME=interview-service
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- MongoDB -----------------------------------------------------------
# In the shared docker-compose, this should point at the Mongo service name,
# e.g. mongodb://mongo:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=interview_db

# --- JWT / Auth Service contract -------------------------------------------
# Must exactly match the Auth Service's signing configuration.
JWT_SECRET_KEY=change-me
JWT_ISSUER=auth-servisi
JWT_AUDIENCE=mulakat-hazirlik
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Local-only dev token endpoint (POST /dev/token) ------------------------
# Must be disabled (or APP_ENV=production) before deploying.
ENABLE_DEV_TOKEN_ENDPOINT=true
DEV_TOKEN_DEFAULT_SUBJECT=dev-user-id

# --- Profile Service (owned by another teammate) ----------------------------
# Shared docker-compose (real service, container name): http://profile-service:8080
PROFILE_SERVICE_URL=http://profile-service:8080
PROFILE_SERVICE_TIMEOUT_SECONDS=5.0

# --- LLM provider ------------------------------------------------------------
# The API key lives ONLY here (in the real .env, never in git). The Profile
# Service should read the same variable names so both services share one key.
# Leave LLM_API_KEY empty to use the offline stub (local dev / tests).
# Provider: anthropic | openai (OpenAI-compatible) | openrouter | azure_openai
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Empty model / base URL = provider defaults (anthropic/openai/openrouter only)
LLM_MODEL=google/gemma-4-31b-it:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2000
# Max characters of job_description / cv_summary (from the Profile Service) kept
# in the snapshot and sent to the LLM. Longer text is truncated.
PROFILE_TEXT_MAX_CHARS=6000
# Required ONLY when LLM_PROVIDER=azure_openai:
#   LLM_BASE_URL   = the resource endpoint, e.g. https://<resource>.openai.azure.com
#   (LLM_MODEL is ignored for azure_openai; the deployment name below is used instead)
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Interview / question defaults ------------------------------------------
DEFAULT_QUESTION_TIME_LIMIT_SECONDS=120
DEFAULT_INTERVIEW_QUESTION_COUNT=5
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100