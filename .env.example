# docker-compose.yml bu dosyadaki değişkenleri okur.
# Kopyala: cp .env.example .env
# Gerçek .env dosyasını asla commit'leme.

# --- JWT (zorunlu) ---
# Auth servisi bu anahtarla imzalar; gateway, profile ve interview aynı anahtarla doğrular.
# HmacSha256 için en az 32 karakter olmalı. Üretmek için: openssl rand -base64 48
JWTSETTINGS_KEY=

# --- Auth DB (PostgreSQL, auth-service) ---
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=

# --- Auth dış servisleri (opsiyonel) ---
EMAIL_PASSWORD=
GOOGLE_CLIENT_ID=

# --- Azure OpenAI (profile-service) ---
# Zorunlu: boş bırakılırsa profile-service açılışta çöker (AzureOpenAI client import anında oluşturuluyor).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini

# --- LLM (interview-service) ---
# Provider: anthropic | openai | azure_openai
# LLM_API_KEY boş bırakılırsa servis offline stub ile çalışır.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# Not: profile-service ve interview-service MongoDB kullanır (compose içindeki
# `mongodb` servisi); ayrı DB kullanıcı/şifresi gerekmez. Eski .env'deki
# PROFILE_DB_*, INTERVIEW_DB_*, OPENAI_API_KEY, VITE_API_URL ve CORS_ORIGIN
# değişkenleri hiçbir servis tarafından okunmuyor.
