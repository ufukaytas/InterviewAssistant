# docker-compose.yml bu dosyadaki değişkenleri okur.
# Kopyala: cp .env.example .env
# Gerçek .env dosyasını asla commit'leme.

# --- JWT (zorunlu) ---
# Auth servisi bu anahtarla imzalar; gateway, profile ve interview aynı anahtarla doğrular.
# HmacSha256 için en az 32 karakter olmalı. Üretmek için: openssl rand -base64 48
JWTSETTINGS_KEY=

# --- Auth DB (PostgreSQL, auth-service) ---
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=

# --- Auth dış servisleri (opsiyonel) ---
EMAIL_PASSWORD=
GOOGLE_CLIENT_ID=

# --- LLM (profile-service + interview-service) ---
# İki servis aynı OpenAI uyumlu endpoint'i ve anahtarı kullanır.
# LLM_PROVIDER yalnızca interview-service içindir: anthropic | openai | openrouter | azure_openai
# LLM_API_KEY boşsa interview-service offline stub ile çalışır; profile-service açılır
# ama CV analizi hata döner.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b
LLM_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2000
PROFILE_TEXT_MAX_CHARS=6000

# Not: profile-service ve interview-service MongoDB kullanır (compose içindeki
# `mongodb` servisi); ayrı DB kullanıcı/şifresi gerekmez. Eski .env'deki
# PROFILE_DB_*, INTERVIEW_DB_*, OPENAI_API_KEY, AZURE_OPENAI_*, VITE_API_URL ve CORS_ORIGIN
# değişkenleri hiçbir servis tarafından okunmuyor.
