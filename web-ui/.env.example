# Kopyala: cp .env.example .env

# --- Web UI / Gateway ---
VITE_API_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3001

# --- Auth DB (auth-service) ---
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=change-me

# --- Profile DB (profile-service) ---
PROFILE_DB_NAME=profile
PROFILE_DB_USER=profile
PROFILE_DB_PASSWORD=change-me

# --- Interview DB (interview-service, pgvector) ---
INTERVIEW_DB_NAME=interview
INTERVIEW_DB_USER=interview
INTERVIEW_DB_PASSWORD=change-me

# --- OpenAI (interview-service) ---
OPENAI_API_KEY=
