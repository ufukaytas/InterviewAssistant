{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Key": "",
    "Issuer": "auth-servisi",
    "Audience": "mulakat-hazirlik",
    "AccessTokenExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "auth-limit",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "interview-route": {
        "ClusterId": "interview-cluster",
        "RateLimiterPolicy": "api-limit",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/interviews/{**catch-all}"
        }
      },
      "questions-route": {
        "ClusterId": "interview-cluster",
        "RateLimiterPolicy": "api-limit",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/questions/{**catch-all}"
        }
      },
      "jobpostings-route": {
        "ClusterId": "profile-cluster",
        "RateLimiterPolicy": "api-limit",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/job-postings/{**catch-all}"
        }
      },
      "cvs-route": {
        "ClusterId": "profile-cluster",
        "RateLimiterPolicy": "api-limit",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/cvs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auth.api:8080"
          }
        }
      },
      "interview-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://interview.api:8080"
          }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cv.api:8080"
          }
        }
      }
    }
  }
}